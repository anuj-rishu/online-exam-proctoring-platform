spring.application.name=labs


# Load .env file automatically (treat it as a properties file)
spring.config.import=optional:file:.env[.properties]

server.tomcat.threads.max=300
server.tomcat.threads.min-spare=50
server.tomcat.max-connections=400
server.tomcat.accept-count=200


spring.data.mongodb.auto-index-creation=true


spring.web.resources.cache.cachecontrol.max-age=0
spring.web.resources.cache.cachecontrol.no-cache=true
spring.web.resources.chain.cache=false


server.compression.enabled=true
server.compression.mime-types=text/html,text/css,application/javascript,application/json
server.compression.min-response-size=1024



spring.mvc.async.request-timeout=30000


spring.mvc.view.prefix=/WEB-INF/jsp/
spring.mvc.view.suffix=.jsp


cloudflare.r2.access-key=${R2_ACCESS_KEY}
cloudflare.r2.secret-key=${R2_SECRET_KEY}
cloudflare.r2.endpoint=${R2_ENDPOINT}
cloudflare.r2.bucket=${R2_BUCKET}


server.tomcat.max-http-form-post-size=20MB
server.tomcat.max-swallow-size=20MB
spring.servlet.multipart.max-file-size=20MB
spring.servlet.multipart.max-request-size=20MB


jwt.secret=${JWT_SECRET}
jwt.expiration.ms=14400000

code.execution.worker.pool-size=6
code.execution.job.timeout-seconds=25


code.execution.sandbox.enabled=${SANDBOX_ENABLED}
code.execution.sandbox.memory=128m
code.execution.sandbox.pids-limit=64
code.execution.sandbox.cpus=0.5
code.execution.sandbox.timeout=5


spring.data.mongodb.uri=${MONGODB_URI}


spring.data.redis.host=${REDIS_HOST}
spring.data.redis.port=${REDIS_PORT}
spring.data.redis.timeout=2000ms
spring.data.redis.lettuce.pool.max-active=32
spring.data.redis.lettuce.pool.max-idle=16
spring.data.redis.lettuce.pool.min-idle=4


app.superadmin.email=${SUPERADMIN_EMAIL}


brevo.api.key=${BREVO_API_KEY}
brevo.sender.email=${BREVO_SENDER_EMAIL}

exam.schedule.date.webdev-aiml=${EXAM_DATE_WEBDEV_AIML}
exam.schedule.time.webdev-aiml=${EXAM_TIME_WEBDEV_AIML}
exam.schedule.date.cloud-appdev=${EXAM_DATE_CLOUD_APPDEV}
exam.schedule.time.cloud-appdev=${EXAM_TIME_CLOUD_APPDEV}


identity.verification.enabled=true
identity.verification.host=127.0.0.1
identity.verification.port=8500
identity.verification.service-dir=python-services/identity-verification
