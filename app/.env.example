# === Cloudflare R2 ===
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_BUCKET=labs-file

# === JWT ===

JWT_SECRET=your_super_secret_jwt_key_here_must_be_long_enough

# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017/labs_db

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === Super Admin ===
# The initial super admin account email
SUPERADMIN_EMAIL=

# === Brevo (Email Service) ===
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=

SANDBOX_ENABLED=true


CORS_ALLOWED_ORIGINS=http://localhost:3000

# === Docker deployment (docker-compose.yml only) ===
# The public hostname Caddy issues a TLS certificate for. Its DNS A record must
# already point at this machine. Ignored when running the app directly.
DOMAIN=labs.srminsider.in
# MONGODB_URI, REDIS_HOST and CORS_ALLOWED_ORIGINS above are overridden by
# docker-compose.yml, which points them at the compose service names.


CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# === Examination Schedule ===
EXAM_DATE_WEBDEV_AIML="19 Sep 2026"
EXAM_TIME_WEBDEV_AIML="7:00 PM to 11:30 PM"
EXAM_DATE_CLOUD_APPDEV="20 Sep 2026"
EXAM_TIME_CLOUD_APPDEV="7:00 PM to 11:30 PM"

# === Performance ===
# Share of the machine's CPU cores student code execution may use. Worker
# count and per-container CPU cap are derived from this and the detected core
# count. Set EXEC_WORKERS / SANDBOX_CPUS to a non-zero value to pin them.
CPU_UTILISATION=0.8
EXEC_WORKERS=0
SANDBOX_CPUS=0
